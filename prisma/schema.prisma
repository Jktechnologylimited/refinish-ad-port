// prisma/schema.prisma
// AutoOps — Complete database schema
// Clone per client, change DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   // bcrypt hashed
  role      Role     @default(WORKER)
  avatar    String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignedBookings Booking[]    @relation("AssignedWorker")
  jobIntakes       JobIntake[]
  sessions         Session[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum Role {
  OWNER
  MANAGER
  WORKER
}

// ─────────────────────────────────────────────
// CUSTOMERS (CRM)
// ─────────────────────────────────────────────

model Customer {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String
  address    String?
  // Car info (primary car — they can have multiple bookings with different cars)
  carMake    String?
  carModel   String?
  carYear    String?
  carColour  String?
  carPlate   String?
  totalSpend Float    @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  bookings Booking[]
  orders   Order[]

  @@map("customers")
}

// ─────────────────────────────────────────────
// BOOKINGS & PIPELINE
// ─────────────────────────────────────────────

model Booking {
  id          String        @id @default(cuid())
  reference   String        @unique @default(cuid()) // public-facing ref
  
  // Customer info (stored directly too in case walk-in)
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id])
  customerName  String
  customerEmail String?
  customerPhone String

  // Car details for this specific booking
  carMake     String
  carModel    String
  carYear     String?
  carColour   String?
  carPlate    String?

  // Service
  serviceType ServiceType
  serviceName String      // e.g. "Full Interior + Exterior Detail"
  servicePrice Float

  // Scheduling
  scheduledDate DateTime
  estimatedCompletion DateTime?

  // Pipeline stage
  stage       BookingStage  @default(BOOKED)

  // Payment
  depositAmount    Float    @default(0)
  depositPaid      Boolean  @default(false)
  depositPaystackRef String?
  balanceAmount    Float    @default(0)
  balancePaid      Boolean  @default(false)
  balancePaystackRef String?
  totalPaid        Float    @default(0)

  // Assignment
  assignedWorkerId String?
  assignedWorker   User?    @relation("AssignedWorker", fields: [assignedWorkerId], references: [id])

  // Notes
  internalNotes   String?
  customerNotes   String?  // notes from customer at booking

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  intake     JobIntake?
  stageHistory BookingStageHistory[]

  @@map("bookings")
}

enum BookingStage {
  BOOKED           // 1. Customer booked, deposit paid
  CAR_RECEIVED     // 2. Car checked in, worker took intake photos
  IN_PROGRESS      // 3. Work started
  QUALITY_CHECK    // 4. Manager reviewing
  COMPLETED        // 5. Done, customer notified
  CANCELLED
}

enum ServiceType {
  INTERIOR_DETAIL
  EXTERIOR_DETAIL
  FULL_DETAIL
  CAR_PAINTING
  CHROME_DELETE
  CERAMIC_COATING
  PAINT_PROTECTION
  BODY_WORK
  DEEP_CLEAN
  CUSTOM
}

model BookingStageHistory {
  id        String       @id @default(cuid())
  bookingId String
  booking   Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  stage     BookingStage
  note      String?
  changedBy String?      // user name
  createdAt DateTime     @default(now())

  @@map("booking_stage_history")
}

// ─────────────────────────────────────────────
// JOB INTAKE (Worker checks in the car)
// ─────────────────────────────────────────────

model JobIntake {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  workerId  String
  worker    User    @relation(fields: [workerId], references: [id])

  // Car condition
  fuelLevel       FuelLevel
  engineOilLevel  FluidLevel
  coolantLevel    FluidLevel   @default(OK)
  tyreCondition   TyreCondition
  mileage         String?
  
  // Damage notes
  existingDamage  String?      // free text description
  customerAgreed  Boolean      @default(false) // customer signed off
  
  // Timestamps
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  // Photos
  photos IntakePhoto[]

  @@map("job_intakes")
}

model IntakePhoto {
  id          String    @id @default(cuid())
  intakeId    String
  intake      JobIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  url         String    // Cloudinary URL
  publicId    String    // Cloudinary public ID for deletion
  caption     String?   // e.g. "Front bumper scratch", "Left door dent"
  photoType   PhotoType @default(INTAKE)
  takenAt     DateTime  @default(now())

  @@map("intake_photos")
}

enum PhotoType {
  INTAKE      // before work
  PROGRESS    // during work
  COMPLETION  // after work
}

enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTER
  FULL
}

enum FluidLevel {
  LOW
  OK
  FULL
}

enum TyreCondition {
  POOR      // needs replacement
  FAIR      // worn but ok
  GOOD
  EXCELLENT
}

// ─────────────────────────────────────────────
// SHOP — PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Float
  comparePrice Float?  // original price for showing discount
  stock       Int      @default(0)
  lowStockAt  Int      @default(5) // alert when stock hits this
  sku         String?  @unique
  category    ProductCategory
  images      String[] // Cloudinary URLs
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  weight      Float?   // for shipping calculation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@map("products")
}

enum ProductCategory {
  WAX_AND_POLISH
  INTERIOR_CARE
  EXTERIOR_CARE
  PAINT_PROTECTION
  MICROFIBRE_AND_TOOLS
  TYRE_CARE
  GLASS_CARE
  FRAGRANCE
  KITS_AND_BUNDLES
  OTHER
}

// ─────────────────────────────────────────────
// SHOP — ORDERS
// ─────────────────────────────────────────────

model Order {
  id         String      @id @default(cuid())
  reference  String      @unique @default(cuid())
  
  // Customer (optional link to CRM)
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  
  // Stored directly for guests
  customerName  String
  customerEmail String
  customerPhone String?
  
  // Shipping address
  address    String?
  city       String?
  state      String?

  // Financials (in Naira)
  subtotal   Float
  shipping   Float       @default(0)
  total      Float
  
  // Payment
  status          OrderStatus   @default(PENDING)
  paystackRef     String?
  paystackChannel String?       // card, bank, ussd etc
  paidAt          DateTime?

  // Fulfilment
  fulfilmentStatus FulfilmentStatus @default(UNFULFILLED)
  trackingNumber   String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float   // price at time of purchase
  total     Float

  @@map("order_items")
}

enum OrderStatus {
  PENDING     // created, payment not confirmed
  PAID        // payment confirmed
  FAILED      // payment failed
  REFUNDED
  CANCELLED
}

enum FulfilmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
}

// ─────────────────────────────────────────────
// SERVICES CATALOGUE
// (what the business offers — editable in admin)
// ─────────────────────────────────────────────

model Service {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Float
  depositPercent Float @default(30) // % required as deposit
  duration    Int     // estimated hours
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())

  @@map("services")
}

// ─────────────────────────────────────────────
// BUSINESS SETTINGS
// (one row per deployment — editable in admin)
// ─────────────────────────────────────────────

model BusinessSettings {
  id              String  @id @default("singleton")
  businessName    String  @default("AutoOps Business")
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  logoUrl         String?
  currency        String  @default("NGN")
  currencySymbol  String  @default("₦")
  paystackPublicKey String?
  
  // Email templates (store as text, interpolated with Resend)
  bookingConfirmEmailSubject String @default("Booking Confirmed — {{businessName}}")
  orderConfirmEmailSubject   String @default("Order Confirmed — {{businessName}}")
  
  updatedAt DateTime @updatedAt

  @@map("business_settings")
}
